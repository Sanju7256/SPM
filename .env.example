# Public origin used by the static build to generate canonical URLs, Open Graph URLs, and sitemap entries.
# In Vercel, configure this as a project environment variable before deploying a rebuilt dist/ directory.
PUBLIC_SITE_URL=https://spminteriorsdesign.com

# Public contact details — leave blank until SPM confirms the real channels.
# WhatsApp number must contain digits only, with country code (e.g. 91XXXXXXXXXX).
# PUBLIC_CONTACT_PHONE accepts comma-separated numbers; each is rendered as a separate tap-to-call link.
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_OFFICE_ADDRESS=

# Official public profiles only; the site accepts HTTPS links on each platform's domain.
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=
PUBLIC_YOUTUBE_URL=

# Public HTTPS endpoint that accepts POST JSON from the lead form. Keep server secrets
# in the endpoint's server-side environment, never in this public variable or browser code.
PUBLIC_LEAD_ENDPOINT=

# Optional verified figures. Leave blank to show a pending placeholder rather than a claim.
# Example display values may be used only while the page clearly labels them as illustrative, unverified placeholders.
# Set PUBLIC_STATS_VERIFIED=true only after SPM confirms every configured figure.
PUBLIC_HOMES_DESIGNED=
PUBLIC_YEARS_EXPERIENCE=
PUBLIC_DESIGN_TEAM=
PUBLIC_CLIENT_RATING=
PUBLIC_STATS_VERIFIED=false
